# App
NEXT_PUBLIC_BASE_URL=https://your-domain.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
BACKEND_ORIGIN=
VIBECHECK_TOKEN_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_ENABLE_MOCK_PAYMENTS=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_UPLOAD_BUCKET=card-uploads

# Razorpay
RAZORPAY_KEY_ID=replace-with-key-id
RAZORPAY_KEY_SECRET=replace-with-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Transactional email through Gmail SMTP
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=replace-with-16-character-google-app-password
EMAIL_FROM_NAME=VibeCheck
EMAIL_REPLY_TO=your-address@gmail.com

# Analytics
POSTHOG_API_KEY=replace-with-posthog-project-key
POSTHOG_HOST=https://app.posthog.com

# GIF search
GIPHY_API_KEY=replace-with-giphy-api-key

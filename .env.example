# App
NEXT_PUBLIC_BASE_URL=https://your-domain.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
BACKEND_ORIGIN=
VIBECHECK_TOKEN_SECRET=replace-with-a-long-random-secret
VIBECHECK_ADMIN_EMAIL=agarwalmohak6@gmail.com
VIBECHECK_ADMIN_WHATSAPP=919565814426
VIBECHECK_ADMIN_SESSION_SECRET=replace-with-a-long-random-admin-session-secret
# Free email on Render: create a Brevo Free account and verify the sender inbox.
# Use an API key, not a Brevo SMTP key. Free plan: 300 sends/day, shared by all emails.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Optional existing Resend integration (requires a verified sending domain).
# Brevo takes priority if both keys are set; no automatic cross-provider retries.
RESEND_API_KEY=
VIBECHECK_EMAIL_FROM=
# Optional alternative for local/SMTP-capable hosting. Render Free blocks SMTP.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=VibeCheck
EMAIL_REPLY_TO=
NEXT_PUBLIC_ENABLE_MOCK_PAYMENTS=false
NEXT_PUBLIC_ENABLE_TEST_MODE=false
VIBECHECK_ENABLE_TEST_MODE=false
WHATSAPP_CLOUD_API_TOKEN=replace-with-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-whatsapp-phone-number-id
WHATSAPP_CLOUD_API_VERSION=v24.0

# Supabase
